# ============ JWT ============
JWT_SECRET=indotel_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ============ Laravel ============
APP_KEY=base64:CHANGE_THIS_WITH_php_artisan_key:generate
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

# ============ Database ============
DB_CONNECTION=sqlite
DB_DATABASE=/app/database/indotel.db

# ============ API ============
INDOTEL_API_URL=http://api:3000/api
INDOTEL_API_TIMEOUT=30

# ============ Admin Default ============
ADMIN_EMAIL=admin@indotel.id
ADMIN_PASSWORD=Admin123!

# ============ CORS ============
CORS_ORIGIN=http://localhost,http://localhost:8000
