APP_NAME=Indotel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=/app/database/indotel.db

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

INDOTEL_API_URL=http://api:3000/api
INDOTEL_API_TIMEOUT=30

FILAMENT_PATH=admin
FILAMENT_BRAND_NAME="Indotel Admin"
