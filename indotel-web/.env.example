APP_NAME=Indotel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=/app/database/indotel.db

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@indotel.id"
MAIL_FROM_NAME="${APP_NAME}"

INDOTEL_API_URL=http://api:3000/api
INDOTEL_API_TIMEOUT=30

FILAMENT_PATH=admin
FILAMENT_BRAND_NAME="Indotel Admin"

RUN_MIGRATIONS=false
