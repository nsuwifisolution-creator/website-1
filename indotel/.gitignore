
#### 2. `.gitignore`
```gitignore
# Dependencies
node_modules/
vendor/

# Environment
.env
.env.local
*.env

# Database
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
database/*.db

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Laravel
indotel-web/storage/*.key
indotel-web/storage/framework/cache/*
indotel-web/storage/framework/sessions/*
indotel-web/storage/framework/views/*
indotel-web/storage/logs/*
indotel-web/bootstrap/cache/*
!indotel-web/storage/.gitkeep
!indotel-web/bootstrap/cache/.gitkeep

# Build
dist/
build/
*.min.js
*.min.css

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml
